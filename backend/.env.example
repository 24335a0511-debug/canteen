# ==============================================================================
# CampusBite Backend Environment Variables Example
# Copy this file to .env or export these in your shell before running
# ==============================================================================

# Active Spring Profile:
# 'dev'  -> Uses In-Memory H2 Database (Default, no local DB installation needed)
# 'prod' -> Uses Persistent PostgreSQL Database
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# Production PostgreSQL Configuration (Required only when SPRING_PROFILES_ACTIVE=prod)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusbite_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/campusbite_db

# Flyway Database Migration
FLYWAY_ENABLED=true

# Hibernate SQL logging
SHOW_SQL=false

# CORS Configuration (Comma-separated origins for Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
